# =============================================================================
# Imagen del frontend de GetBela en produccion.
#
# A diferencia de la imagen de desarrollo (docker/frontend/Dockerfile), esta
# NO usa bind mount: el codigo y el build se copian dentro de la imagen.
#
# Motivo: en el VPS el codigo se clona en el build, y un bind mount del
# repositorio sobre /app taparia el node_modules que instala la imagen.
#
# El build (npm ci && npm run build) corre en una etapa aparte y solo se
# queda el resultado en la imagen final: el frontend de produccion es un
# sitio estatico servido por nginx, no el dev-server de Vite.
#
# -----------------------------------------------------------------------------
# ARGUMENTOS DE BUILD
#
# VITE_API_URL es la URL base de la API que el frontend compila dentro del
# bundle.
#
# En produccion se deja VACIO: el frontend y la API comparten el dominio
# (https://getbela.syrexsoftware.com), y las rutas del codigo ya incluyen
# el prefijo /api (por ejemplo api.get("/api/public/services")). Con la base
# vacia axios resuelve contra el dominio actual y el resultado es
# /api/public/services, que es la ruta que sirve el backend.
#
# Un valor "/api" produciria /api/api/public/services: el prefijo duplicado.
#
# Con la base relativa el navegador no necesita CORS y las cookies de sesion
# son de primer origen.
# -----------------------------------------------------------------------------
FROM node:22-alpine AS build

ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app

# Se copian primero solo los manifiestos: mientras no cambien, la capa de
# dependencias se reutiliza entre builds.
#
# El codigo vive en ./app/frontend (el repo clonado), no en ./frontend: el
# contexto de build es la raiz del proyecto GetBela.
COPY app/frontend/package.json app/frontend/package-lock.json ./

RUN npm ci --no-audit --no-fund

# El codigo fuente y la configuracion de build.
COPY app/frontend/ ./

RUN npm run build

# -----------------------------------------------------------------------------
# Etapa final: nginx sirviendo los estaticos.
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Configuracion del servidor: SPA fallback a index.html y cache de assets.
COPY docker/frontend/nginx/default.conf /etc/nginx/conf.d/default.conf

# Los assets de Vite llevan hash en el nombre, asi que se pueden cachear
# para siempre. index.html no: debe revalidarse siempre para que un deploy
# nuevo se vea de inmediato.
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --spider -q http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
