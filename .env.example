# =============================================================================
# GetBela - GRUPO GETBELA (plantilla)
#
# Copiar a .env y cambiar los valores:
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# MySQL del grupo getbela
#
# Base y usuario PROPIOS de GetBela. No tienen relacion con el MySQL de
# docker-windows (que es 5.7 y usa la base "puntopay"): este grupo es
# independiente.
# -----------------------------------------------------------------------------
GETBELA_MYSQL_ROOT_PASSWORD=
GETBELA_DB_DATABASE=getbela
GETBELA_DB_USERNAME=getbela
GETBELA_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Zona horaria de los contenedores
# -----------------------------------------------------------------------------
TZ=America/Santiago